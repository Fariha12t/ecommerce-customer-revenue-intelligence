table customer_rfm

	column customer_unique_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_unique_id

	column last_purchase
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: last_purchase

	column frequency
		dataType: double
		summarizeBy: none
		sourceColumn: frequency

	column monetary
		dataType: double
		summarizeBy: none
		sourceColumn: monetary

	column recency_days
		dataType: double
		summarizeBy: none
		sourceColumn: recency_days

	column r_score
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: r_score

	column f_score
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: f_score

	column m_score
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: m_score

	column rfm_score
		dataType: string
		summarizeBy: none
		sourceColumn: rfm_score

	column segment
		dataType: string
		summarizeBy: none
		sourceColumn: segment

	measure 'RFM Customers' = DISTINCTCOUNT(customer_rfm[customer_unique_id])
		formatString: #,0

	measure 'Segment Value' = SUM(customer_rfm[monetary])
		formatString: #,0

	partition customer_rfm = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "reports\generated\customer_rfm.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"customer_unique_id", "last_purchase", "frequency", "monetary", "recency_days", "r_score", "f_score", "m_score", "rfm_score", "segment"}),
					Typed = Table.TransformColumnTypes(Selected, {{"customer_unique_id", type text}, {"last_purchase", type datetime}, {"frequency", type number}, {"monetary", type number}, {"recency_days", type number}, {"r_score", Int64.Type}, {"f_score", Int64.Type}, {"m_score", Int64.Type}, {"rfm_score", type text}, {"segment", type text}}, "en-US")
				in
					Typed
