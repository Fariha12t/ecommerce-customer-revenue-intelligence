table order_risk_scores

	column order_id
		dataType: string
		summarizeBy: none
		sourceColumn: order_id

	column order_purchase_timestamp
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: order_purchase_timestamp

	column is_late
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: is_late

	column late_probability
		dataType: double
		summarizeBy: none
		sourceColumn: late_probability

	column split
		dataType: string
		summarizeBy: none
		sourceColumn: split

	column risk_band
		dataType: string
		summarizeBy: none
		sourceColumn: risk_band
		sortByColumn: 'Risk Band Sort'

	column 'Risk Band Sort' = SWITCH(order_risk_scores[risk_band],"High",1,"Medium",2,"Low",3)
		dataType: int64
		formatString: 0
		summarizeBy: none

	partition order_risk_scores = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "reports\generated\ml_late\order_risk_scores.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"order_id", "order_purchase_timestamp", "is_late", "late_probability", "split", "risk_band"}),
					Typed = Table.TransformColumnTypes(Selected, {{"order_id", type text}, {"order_purchase_timestamp", type datetime}, {"is_late", Int64.Type}, {"late_probability", type number}, {"split", type text}, {"risk_band", type text}}, "en-US")
				in
					Typed
