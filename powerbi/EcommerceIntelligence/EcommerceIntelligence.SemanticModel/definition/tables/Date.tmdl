table Date
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month No'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month No]

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: 'Month Sort'

	column 'Month Sort'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Sort]

	partition Date = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2016,9,1),DATE(2018,12,31)),"Year",YEAR([Date]),"Month No",MONTH([Date]),"Month",FORMAT([Date],"MMM yy"),"Month Sort",YEAR([Date])*100+MONTH([Date]))
