table customer_scores

	column customer_unique_id
		dataType: string
		summarizeBy: none
		sourceColumn: customer_unique_id

	column prediction_time
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: prediction_time

	column repeat_purchase
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: repeat_purchase

	column repeat_probability
		dataType: double
		summarizeBy: none
		sourceColumn: repeat_probability

	column split
		dataType: string
		summarizeBy: none
		sourceColumn: split

	column score_decile
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: score_decile

	measure 'Actual Repeat Rate' = AVERAGE(customer_scores[repeat_purchase])
		formatString: 0.0%

	partition customer_scores = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "reports\generated\ml\customer_scores.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Promoted, {"customer_unique_id", "prediction_time", "repeat_purchase", "repeat_probability", "split", "score_decile"}),
					Typed = Table.TransformColumnTypes(Selected, {{"customer_unique_id", type text}, {"prediction_time", type datetime}, {"repeat_purchase", Int64.Type}, {"repeat_probability", type number}, {"split", type text}, {"score_decile", Int64.Type}}, "en-US")
				in
					Typed
